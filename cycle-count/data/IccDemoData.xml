                        createdDate="2026-03-30 09:45:00" />

    <!-- Demo Count Items for DEMO_COUNT_03 (Submitted - with discrepancies) -->
    <!-- Case 1: Perfect match -->
    <InventoryCountItem inventoryCountId="DEMO_COUNT_03" countItemSeqId="00001" productId="GZ-1006" productIdentifier="890123456789"
                        locationSeqId="TL-01" quantity="10" systemQuantity="10" statusId="ICC_ITEM_VERIFIED"
                        createdDate="2026-03-30 10:15:00" />
    
