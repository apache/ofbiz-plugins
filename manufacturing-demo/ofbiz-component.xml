<ofbiz-component name="manufacturing-demo" enabled="true"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-component.xsd">
    <resource-loader name="main" type="component"/>

    <!-- Custom reader name: this demo loads ONLY when explicitly requested via
         readers=...,manufacturingDemo, so it never dirties the stock seed/demo data sets.
         It is SELF-CONTAINED: it brings its own company, security grants and all manufacturing data,
         so it loads on seed + seed-initial WITHOUT the stock 'demo' data set:
           readers=seed,seed-initial,manufacturingDemo -->
    <entity-resource type="data" reader-name="manufacturingDemo" loader="main" location="data/ManufacturingMrpDemoData.xml"/>
</ofbiz-component>
