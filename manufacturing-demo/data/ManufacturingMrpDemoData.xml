    <PartyContactMech partyId="SUP_005" contactMechId="CM_SUP005" fromDate="2024-01-01 00:00:00"/>

    <!-- Vendor relationships for the purchased raw materials.
         (lastPrice is the OFBiz field for the supplier's quoted price.) -->
