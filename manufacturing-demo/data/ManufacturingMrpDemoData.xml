    <PostalAddress contactMechId="CM_SUP002" toName="Adhesive Solutions Inc." address1="200 Chemical Way"
            city="Houston" stateProvinceGeoId="TX" postalCode="77001" countryGeoId="USA"/>
    <PartyContactMech partyId="SUP_002" contactMechId="CM_SUP002" fromDate="2024-01-01 00:00:00"/>

    <Party partyId="SUP_003" partyTypeId="PARTY_GROUP"/>
    <PartyGroup partyId="SUP_003" groupName="Sticker Print Co."/>
    <PartyRole partyId="SUP_003" roleTypeId="SUPPLIER" fromDate="2024-01-01 00:00:00"/>
    <ContactMech contactMechId="CM_SUP003" contactMechTypeId="POSTAL_ADDRESS"/>
    <PostalAddress contactMechId="CM_SUP003" toName="Sticker Print Co." address1="789 Graphics Blvd"
            city="Los Angeles" stateProvinceGeoId="CA" postalCode="90001" countryGeoId="USA"/>
    <PartyContactMech partyId="SUP_003" contactMechId="CM_SUP003" fromDate="2024-01-01 00:00:00"/>

    <Party partyId="SUP_004" partyTypeId="PARTY_GROUP"/>
    <PartyGroup partyId="SUP_004" groupName="Universal Bearings Ltd."/>
    <PartyRole partyId="SUP_004" roleTypeId="SUPPLIER" fromDate="2024-01-01 00:00:00"/>
    <ContactMech contactMechId="CM_SUP004" contactMechTypeId="POSTAL_ADDRESS"/>
    <PostalAddress contactMechId="CM_SUP004" toName="Universal Bearings Ltd." address1="321 Precision Circle"
            city="Detroit" stateProvinceGeoId="MI" postalCode="48201" countryGeoId="USA"/>
    <PartyContactMech partyId="SUP_004" contactMechId="CM_SUP004" fromDate="2024-01-01 00:00:00"/>

    <Party partyId="SUP_005" partyTypeId="PARTY_GROUP"/>
    <PartyGroup partyId="SUP_005" groupName="Packaging Solutions LLC"/>
    <PartyRole partyId="SUP_005" roleTypeId="SUPPLIER" fromDate="2024-01-01 00:00:00"/>
    <ContactMech contactMechId="CM_SUP005" contactMechTypeId="POSTAL_ADDRESS"/>
    <PostalAddress contactMechId="CM_SUP005" toName="Packaging Solutions LLC" address1="654 Corrugated Ln"
