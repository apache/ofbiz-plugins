<forms xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Widget-Form" xsi:schemaLocation="http://ofbiz.apache.org/Widget-Form http://ofbiz.apache.org/dtds/widget-form.xsd">

    <form name="FindAiAgentRuns" type="single" target="FindAiAgentRun"
            default-map-name="parameters">
        <field name="noConditionFind"><hidden value="Y"/></field>
        <field name="agentName" title="${uiLabelMap.AiAgentName}">
            <text-find ignore-case="true"/>
        </field>
        <field name="userLoginId" title="${uiLabelMap.AiUserLoginId}">
            <text-find ignore-case="true"/>
        </field>
        <field name="statusId" title="${uiLabelMap.AiStatus}">
            <drop-down allow-empty="true">
                <entity-options entity-name="StatusItem" key-field-name="statusId" description="${description}">
                    <entity-constraint name="statusTypeId" value="AI_AGENT_RUN"/>
                    <entity-order-by field-name="description"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="startedAt_fld0_value" title="${uiLabelMap.AiFromDate}">
            <date-time type="date-time"/>
        </field>
        <field name="startedAt_fld0_op"><hidden value="greaterThanEqualTo"/></field>
        <field name="startedAt_fld1_value" title="${uiLabelMap.AiThruDate}">
            <date-time type="date-time"/>
        </field>
        <field name="startedAt_fld1_op"><hidden value="lessThanEqualTo"/></field>
        <field name="searchButton" title="${uiLabelMap.CommonFind}" widget-style="smallSubmit">
            <submit button-type="button"/>
        </field>
    </form>

    <form name="ListAiAgentRuns" type="list" list-name="listIt" target=""
            paginate-target="FindAiAgentRun" odd-row-style="alternate-row"
            default-table-style="basic-table hover-bar">
        <actions>
            <service service-name="performFind" result-map="result" result-map-list="listIt">
                <field-map field-name="inputFields" from-field="parameters"/>
                <field-map field-name="entityName" value="AiAgentRun"/>
                <field-map field-name="orderBy" value="startedAt DESC"/>
                <field-map field-name="viewIndex" from-field="viewIndex"/>
                <field-map field-name="viewSize" from-field="viewSize"/>
            </service>
        </actions>
        <field name="runId" title="${uiLabelMap.AiRunId}">
            <hyperlink description="${runId}" target="AiAgentRunDetail">
                <parameter param-name="runId"/>
            </hyperlink>
        </field>
        <field name="agentName" title="${uiLabelMap.AiAgentName}"><display/></field>
        <field name="userLoginId" title="${uiLabelMap.AiUserLoginId}"><display/></field>
        <field name="statusId" title="${uiLabelMap.AiStatus}">
            <display-entity entity-name="StatusItem" key-field-name="statusId" description="${description}"/>
        </field>
        <field name="startedAt" title="${uiLabelMap.AiStartedAt}"><display/></field>
        <field name="endedAt" title="${uiLabelMap.AiEndedAt}"><display/></field>
        <field name="iterationsUsed" title="${uiLabelMap.AiIterations}"><display/></field>
    </form>

    <form name="ViewAiAgentRun" type="single" default-map-name="agentRun">
        <field name="runId" title="${uiLabelMap.AiRunId}"><display/></field>
        <field name="agentName" title="${uiLabelMap.AiAgentName}"><display/></field>
        <field name="userLoginId" title="${uiLabelMap.AiUserLoginId}"><display/></field>
        <field name="statusId" title="${uiLabelMap.AiStatus}">
            <display-entity entity-name="StatusItem" key-field-name="statusId" description="${description}"/>
        </field>
        <field name="startedAt" title="${uiLabelMap.AiStartedAt}"><display/></field>
        <field name="endedAt" title="${uiLabelMap.AiEndedAt}"><display/></field>
        <field name="iterationsUsed" title="${uiLabelMap.AiIterations}"><display/></field>
        <field name="inputTokens" title="${uiLabelMap.AiInputTokens}"><display/></field>
        <field name="outputTokens" title="${uiLabelMap.AiOutputTokens}"><display/></field>
        <field name="userMessage" title="${uiLabelMap.AiUserMessage}"><display/></field>
        <field name="assistantMessage" title="${uiLabelMap.AiAssistantMessage}"><display/></field>
    </form>

    <form name="ListAiAgentToolCalls" type="list" list-name="listIt" target=""
            paginate-target="AiAgentRunDetail" odd-row-style="alternate-row"
            default-table-style="basic-table hover-bar">
        <actions>
            <service service-name="performFind" result-map="result" result-map-list="listIt">
                <field-map field-name="inputFields" from-field="parameters"/>
                <field-map field-name="entityName" value="AiAgentToolCall"/>
                <field-map field-name="orderBy" value="calledAt ASC"/>
                <field-map field-name="viewIndex" from-field="viewIndex"/>
                <field-map field-name="viewSize" from-field="viewSize"/>
            </service>
        </actions>
        <field name="callId" title="${uiLabelMap.AiCallId}"><display/></field>
        <field name="toolName" title="${uiLabelMap.AiToolName}"><display/></field>
        <field name="statusId" title="${uiLabelMap.AiStatus}">
            <display-entity entity-name="StatusItem" key-field-name="statusId" description="${description}"/>
        </field>
        <field name="calledAt" title="${uiLabelMap.AiCalledAt}"><display/></field>
        <field name="callArguments" title="${uiLabelMap.AiCallArguments}"><display/></field>
        <field name="callResult" title="${uiLabelMap.AiCallResult}"><display/></field>
    </form>


    <form name="UsageDashboardFilter" type="single" target="AiUsageDashboard"
            default-map-name="parameters">
        <field name="agentName" title="${uiLabelMap.AiAgentName}"><text/></field>
        <field name="fromDate" title="${uiLabelMap.AiFromDate}"><date-time type="date-time"/></field>
        <field name="thruDate" title="${uiLabelMap.AiThruDate}"><date-time type="date-time"/></field>
        <field name="submitButton" title="${uiLabelMap.CommonFind}" widget-style="smallSubmit">
            <submit button-type="button"/>
        </field>
    </form>

    <form name="UsageSummaryResults" type="single">
        <field name="totalRuns" title="${uiLabelMap.AiTotalRuns}">
            <display description="${totalRuns}"/>
        </field>
        <field name="totalInputTokens" title="${uiLabelMap.AiTotalInputTokens}">
            <display description="${totalInputTokens}"/>
        </field>
        <field name="totalOutputTokens" title="${uiLabelMap.AiTotalOutputTokens}">
            <display description="${totalOutputTokens}"/>
        </field>
        <field name="estimatedCostUsd" title="${uiLabelMap.AiEstimatedCostUsd}">
            <display description="${estimatedCostUsd}"/>
        </field>
    </form>


    <form name="FindAiAgentProposals" type="single" target="FindAiAgentProposal"
            default-map-name="parameters">
        <field name="noConditionFind"><hidden value="Y"/></field>
        <field name="agentName" title="${uiLabelMap.AiAgentName}">
            <text-find ignore-case="true"/>
        </field>
        <field name="statusId" title="${uiLabelMap.AiStatus}">
            <drop-down allow-empty="true">
                <entity-options entity-name="StatusItem" key-field-name="statusId" description="${description}">
                    <entity-constraint name="statusTypeId" value="AI_AGENT_PROPOSAL"/>
                    <entity-order-by field-name="description"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="searchButton" title="${uiLabelMap.CommonFind}" widget-style="smallSubmit">
            <submit button-type="button"/>
        </field>
    </form>

    <form name="ListAiAgentProposals" type="list" list-name="listIt" target=""
            paginate-target="FindAiAgentProposal" odd-row-style="alternate-row"
            default-table-style="basic-table hover-bar">
        <actions>
            <service service-name="performFind" result-map="result" result-map-list="listIt">
                <field-map field-name="inputFields" from-field="parameters"/>
                <field-map field-name="entityName" value="AiAgentProposal"/>
                <field-map field-name="orderBy" value="runId DESC"/>
                <field-map field-name="viewIndex" from-field="viewIndex"/>
                <field-map field-name="viewSize" from-field="viewSize"/>
            </service>
        </actions>
        <field name="proposalId" title="${uiLabelMap.AiProposalId}"><display/></field>
        <field name="runId" title="${uiLabelMap.AiRunId}">
            <hyperlink description="${runId}" target="AiAgentRunDetail">
                <parameter param-name="runId"/>
            </hyperlink>
        </field>
        <field name="agentName" title="${uiLabelMap.AiAgentName}"><display/></field>
        <field name="userLoginId" title="${uiLabelMap.AiUserLoginId}"><display/></field>
        <field name="statusId" title="${uiLabelMap.AiStatus}">
            <display-entity entity-name="StatusItem" key-field-name="statusId" description="${description}"/>
        </field>
        <field name="approveLink" title="${uiLabelMap.AiApprove}" widget-style="buttontext">
            <hyperlink description="${uiLabelMap.AiApprove}" target="approveProposal"
                    also-hidden="false">
                <parameter param-name="proposalId"/>
                <auto-attributes include="all"/>
            </hyperlink>
        </field>
        <field name="rejectLink" title="${uiLabelMap.AiReject}" widget-style="buttontext">
            <hyperlink description="${uiLabelMap.AiReject}" target="RejectProposalForm"
                    also-hidden="false">
                <parameter param-name="proposalId"/>
            </hyperlink>
        </field>
    </form>

    <form name="RejectProposal" type="single" target="rejectProposal"
            default-map-name="parameters">
        <field name="proposalId"><hidden/></field>
        <field name="rejectionReason" title="${uiLabelMap.AiRejectionReason}">
            <textarea rows="5" cols="60"/>
        </field>
        <field name="submitButton" title="${uiLabelMap.AiReject}" widget-style="smallSubmit">
            <submit button-type="button"/>
        </field>
    </form>

</forms>
