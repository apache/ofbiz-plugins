<entity-engine-xml>

    <!-- StatusType for AI Agent Run -->
    <StatusType statusTypeId="AI_AGENT_RUN"
                description="AI Agent Run Status"
                parentTypeId=""/>

    <!-- StatusItem rows for AiAgentRun -->
    <StatusItem statusId="AI_RUN_STARTED"   statusTypeId="AI_AGENT_RUN"
                statusCode="STARTED"   description="Started"   sequenceId="01"/>
    <StatusItem statusId="AI_RUN_COMPLETED" statusTypeId="AI_AGENT_RUN"
                statusCode="COMPLETED" description="Completed" sequenceId="02"/>
    <StatusItem statusId="AI_RUN_FAILED"    statusTypeId="AI_AGENT_RUN"
                statusCode="FAILED"    description="Failed"    sequenceId="03"/>

    <!-- StatusType for AI Tool Call -->
    <StatusType statusTypeId="AI_TOOL_CALL"
                description="AI Agent Tool Call Status"
                parentTypeId=""/>

    <!-- StatusItem rows for AiAgentToolCall -->
    <StatusItem statusId="AI_TOOL_COMPLETED" statusTypeId="AI_TOOL_CALL"
                statusCode="COMPLETED" description="Completed" sequenceId="01"/>
    <StatusItem statusId="AI_TOOL_FAILED"    statusTypeId="AI_TOOL_CALL"
                statusCode="FAILED"    description="Failed"    sequenceId="02"/>

    <!-- StatusType and StatusItem for conversation threads -->
    <StatusType statusTypeId="AI_CONV_THREAD"
                description="AI Conversation Thread Status"
                parentTypeId=""/>
    <StatusItem statusId="AI_THREAD_ACTIVE"   statusTypeId="AI_CONV_THREAD"
                statusCode="ACTIVE"   description="Active"   sequenceId="01"/>
    <StatusItem statusId="AI_THREAD_ARCHIVED" statusTypeId="AI_CONV_THREAD"
                statusCode="ARCHIVED" description="Archived" sequenceId="02"/>

    <!-- AiProviderCost rows — prices in USD per 1M tokens (as of 2026-05) -->
    <AiProviderCost modelId="gpt-4o"                    effectiveDate="2026-01-01 00:00:00.000" inputCostPerMillion="2.50"  outputCostPerMillion="10.00" currencyUomId="USD"/>
    <AiProviderCost modelId="gpt-4o-mini"               effectiveDate="2026-01-01 00:00:00.000" inputCostPerMillion="0.15"  outputCostPerMillion="0.60"  currencyUomId="USD"/>
    <AiProviderCost modelId="gpt-4.1"                   effectiveDate="2026-01-01 00:00:00.000" inputCostPerMillion="2.00"  outputCostPerMillion="8.00"  currencyUomId="USD"/>
    <AiProviderCost modelId="claude-opus-4-5"           effectiveDate="2026-01-01 00:00:00.000" inputCostPerMillion="15.00" outputCostPerMillion="75.00" currencyUomId="USD"/>
    <AiProviderCost modelId="claude-sonnet-4-5"         effectiveDate="2026-01-01 00:00:00.000" inputCostPerMillion="3.00"  outputCostPerMillion="15.00" currencyUomId="USD"/>
    <AiProviderCost modelId="claude-3-5-haiku-20241022" effectiveDate="2026-01-01 00:00:00.000" inputCostPerMillion="0.80"  outputCostPerMillion="4.00"  currencyUomId="USD"/>

    <!-- StatusType and StatusItems for AI Agent Proposals -->
    <StatusType statusTypeId="AI_AGENT_PROPOSAL"
                description="AI Agent Proposal Status"
                parentTypeId=""/>
    <StatusItem statusId="AI_PROPOSAL_PENDING"  statusTypeId="AI_AGENT_PROPOSAL"
                statusCode="PENDING"  description="Pending"  sequenceId="01"/>
    <StatusItem statusId="AI_PROPOSAL_APPROVED" statusTypeId="AI_AGENT_PROPOSAL"
                statusCode="APPROVED" description="Approved" sequenceId="02"/>
    <StatusItem statusId="AI_PROPOSAL_REJECTED" statusTypeId="AI_AGENT_PROPOSAL"
                statusCode="REJECTED" description="Rejected" sequenceId="03"/>

</entity-engine-xml>
